NODE_ENV=production
WAPALA_MODE=backend
APP_URL=https://wapala.example.org
DATABASE_URL=postgresql://wapala:REPLACE_PASSWORD@127.0.0.1:5432/wapala
SECURITY_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
TRUST_PROXY=true
EMAIL_MODE=smtp
# Provider tanpa SMTP: gunakan EMAIL_MODE=disabled dan jangan aktifkan worker email.
# Pemulihan Super User memakai auth:recover-superuser lewat SSH; admin lain direset Super User.
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=admin@example.org
MEDIA_ROOT=/var/lib/wapala/media
MEDIA_SCANNER=/usr/local/libexec/clamdscan-wapala
# clamd owns /var/lib/clamav; do not override database for clamdscan.
HOSTNAME=127.0.0.1
PORT=3000
NODE_OPTIONS=--max-old-space-size=640
